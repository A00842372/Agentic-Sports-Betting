[Unit]
Description=Back up PostgreSQL collection history
After=postgresql.service

[Service]
Type=oneshot
User=agentic-backup
EnvironmentFile=/etc/agentic-sports-betting/backup.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/env ${BACKUP_PYTHON} ${BACKUP_REPOSITORY}/Scrapper/backup_history.py backup --directory %S/agentic-history-backups --source-service ${BACKUP_SERVICE} --match-id ${BACKUP_MATCH_ID}
StateDirectory=agentic-history-backups
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
TimeoutStartSec=infinity
StandardOutput=journal
StandardError=journal
